{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://goalworld.fun/schemas/lore_schema.v0.json",
  "title": "GoalWorldLoreSchemaV0",
  "description": "Base schema for validating GoalWorld lore entries, including characters, worlds, and chapters.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "v0"
    },
    "saga_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string"
    },
    "genre": {
      "type": "string",
      "enum": ["fantasy", "sci-fi", "cyberpunk", "historical", "other"]
    },
    "tone": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string"
        }
      },
      "required": ["author", "created_at"]
    },
    "world_building": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "rules_of_magic_or_physics": {
          "type": "string"
        },
        "timeline": {
          "type": "string"
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": ["name", "description"]
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": ["protagonist", "antagonist", "supporting", "deuteragonist", "ensemble"]
          },
          "biography": {
            "type": "string",
            "minLength": 1
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "type": ["string", "number", "integer", "boolean"]
            }
          },
          "relationships": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "target_id": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                }
              },
              "required": ["target_id", "type"]
            }
          }
        },
        "required": ["id", "name", "role", "biography"]
      }
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "chapter_number": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string"
          },
          "content_markdown_path": {
            "type": "string",
            "minLength": 1
          },
          "slug": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["chapter_number", "title", "content_markdown_path"]
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "themes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "canon_facts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "open_threads": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "required": ["schema_version", "saga_id", "title", "genre", "metadata", "world_building", "characters", "chapters"]
}
